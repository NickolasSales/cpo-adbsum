# ---------------------------------------------------------------------------
# CPO Provas - modelo de configuracao
#
# Copie para .env e preencha. O arquivo .env NAO e versionado.
# Nenhum valor real de segredo pode ser commitado neste arquivo.
# ---------------------------------------------------------------------------

# Chave de assinatura do Django. Obrigatoria, sem valor padrao.
# Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True apenas em desenvolvimento. Em producao precisa ser False.
DEBUG=True

# Conexao PostgreSQL. Unica forma de configurar o banco em qualquer ambiente.
DATABASE_URL=postgresql://cpo_user:SENHA@127.0.0.1:5432/cpo_provas

# Hosts aceitos, separados por virgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens confiaveis para CSRF. Necessario em producao, com esquema incluido.
# Exemplo: https://provas.exemplo.com.br
CSRF_TRUSTED_ORIGINS=

# URL publica da aplicacao. Usada em links e, futuramente, no QR Code dos
# certificados.
SITE_URL=http://127.0.0.1:8000

# Nome da instituicao exibido na interface e nos certificados.
INSTITUTION_NAME=CPO

# Senha inicial atribuida a alunos criados ou importados (Etapa 2).
# Nunca e exibida em tela, relatorio ou log.
DEFAULT_STUDENT_PASSWORD=

# ---------------------------------------------------------------------------
# Opcionais - descomente somente quando necessario
# ---------------------------------------------------------------------------

# Ligar apenas quando houver um proxy reverso confiavel (Nginx) na frente da
# aplicacao. Sem proxy, X-Forwarded-For e falsificavel pelo cliente.
# TRUST_PROXY_HEADERS=False

# Nivel de log: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# Duracao da sessao em segundos. Precisa ser maior que a duracao da maior
# prova, para que nenhuma sessao expire durante uma avaliacao.
# SESSION_COOKIE_AGE=43200

# Reaproveitamento de conexao com o banco, em segundos.
# DB_CONN_MAX_AGE=60

# Escopo do HSTS. Padrao False nos dois: includeSubDomains alcancaria
# qualquer subdominio abaixo do host, e preload e porta de sentido unico —
# sair da lista embutida dos navegadores leva meses e depende de terceiro.
# So ligue quando a zona DNS for controlada de ponta a ponta.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Endurecimento de producao (aplicado quando DEBUG=False).
#
# As quatro opcoes abaixo ja valem no padrao seguro. Declare-as SOMENTE para
# afrouxar, e somente enquanto a excecao durar.
#
# Excecao conhecida: deploy de fumaca acessado por IP, sem dominio e sem
# certificado. Um cookie marcado como Secure nunca e devolvido pelo navegador
# em HTTP, entao o login se torna impossivel sem esta combinacao:
#
#   SESSION_COOKIE_SECURE=False
#   CSRF_COOKIE_SECURE=False
#   SECURE_SSL_REDIRECT=False
#   SECURE_HSTS_SECONDS=0
#
# Assim que o dominio e o certificado existirem, remova as quatro linhas do
# .env daquele ambiente. Nao basta trocar para True: o padrao ja e True, e
# menos configuracao e menos coisa para esquecer.
#
# Atencao: um valor nao reconhecido (vazio, "0", erro de digitacao) e lido
# como False e DESLIGA a protecao. Reveja o .env antes de subir.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
